# ── Supabase ──────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# ── Database (Supabase PostgreSQL via Pooler) ─────────
DATABASE_URL=postgresql+asyncpg://postgres.your-project:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?prepared_statement_cache_size=0
GOOGLE_API_KEY=your_google_api_key

ANONNKEY=your_supabase_anon_key
SUPABASE_JWT_SECRET="your_jwt_secret"

# ── WebDAV (Hetzner Storage Box) ─────────────────────
WEBDAV_BASE_URL=https://uXXXXXX-subX.your-storagebox.de
WEBDAV_USERNAME=uXXXXXX-subX
WEBDAV_PASSWORD="your_webdav_password"
WEBDAV_BASE_DIR=/

# ── Stripe Billing ──────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_DEFAULT_PRICE_ID=price_xxx
FRONTEND_APP_URL=http://localhost:3000
